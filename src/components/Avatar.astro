---
/**
 * Foto de perfil.
 * Para usar tu foto, guardala como src/assets/foto.jpg (o .png / .webp).
 * Si no hay foto, se muestran tus iniciales.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';

interface Props {
  size?: number;
}
const { size = 88 } = Astro.props;

const found = import.meta.glob<{ default: ImageMetadata }>('/src/assets/foto.{jpg,jpeg,png,webp}', {
  eager: true,
});
const photo = Object.values(found)[0]?.default;
---

<div class="avatar" style={`--size:${size}px`}>
  {
    photo ? (
      <Image src={photo} alt={site.name} width={size * 2} height={size * 2} loading="eager" />
    ) : (
      <span aria-hidden="true">{site.initials}</span>
    )
  }
</div>

<style>
  .avatar {
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    padding: 3px;
    background: conic-gradient(from 200deg, var(--green), #2aa8ff, var(--green));
    flex: none;
  }
  .avatar img,
  .avatar span {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 3px solid var(--bg);
    object-fit: cover;
  }
  .avatar span {
    display: grid;
    place-items: center;
    background: var(--raised);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: calc(var(--size) * 0.32);
    color: var(--text);
    letter-spacing: 0.02em;
  }
</style>
