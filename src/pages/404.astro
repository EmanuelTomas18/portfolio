---
import Base from '../layouts/Base.astro';
---

<Base lang="es" title="404 | Sergio Emanuel Tomas" noindex>
  <main id="main" class="nf wrap">
    <pre aria-hidden="true"><span class="err">KeyError</span>: 'page'</pre>
    <h1>Esta página no existe</h1>
    <p lang="en">This page doesn’t exist.</p>
    <div class="links">
      <a class="btn btn-primary" href="/">Volver al inicio</a>
      <a class="btn" href="/en/" lang="en">Go to home</a>
    </div>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }
  pre {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--muted);
  }
  .err {
    color: #ff8a8a;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  p {
    color: var(--muted);
    font-size: var(--step-1);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
